# Haki chain — Base Sepolia (TESTNET ONLY).
# Copy to chain/.env (gitignored). Never commit or share a real .env.

# Public RPC from the official Base docs; swap for your own provider if you have one.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Throwaway wallet key, funded from a faucet. TESTNET ONLY.
# Generate one: npm run wallet
ATTESTER_PK=

# Set by `npm run schema` — the UID of the registered Haki schema.
SCHEMA_UID=
